{
	"name": "papergraph3d",
	"version": "1.0.0",
	"description": "Collects, embeds, and visualizes academic papers as a 3D graph.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node esbuild.test.mjs && node --test \".test-build/**/*.test.mjs\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"dependencies": {
		"@huggingface/transformers": "^3.0.0",
		"3d-force-graph": "^1.80.0",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22.15.17",
		"@types/three": "^0.185.4",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^30.0.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
